# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# --- founder-sim serve ---
FOUNDER_SIM_MASTER_KEY=change-me-to-a-long-random-string   # encrypts player API keys at rest (16+ chars)
FOUNDER_SIM_BASE_URL=http://localhost:8080                 # public URL used in magic links
FOUNDER_SIM_FAKE_LLM=0                                     # 1 = play with the built-in fake model
FOUNDER_SIM_PLUGINS=                                       # comma-separated URLs of remote HTTP plugins

# --- founder-sim-content ingest (story pipeline) ---
FOUNDER_SIM_LLM_BASE_URL=https://api.openai.com/v1
FOUNDER_SIM_LLM_MODEL=gpt-4o
FOUNDER_SIM_LLM_API_KEY=
FOUNDER_SIM_LLM_JSON_MODE=1

# --- founder-sim-bridge (on a player's machine) ---
FOUNDER_SIM_SERVER=https://your-server
FOUNDER_SIM_BRIDGE_TOKEN=
